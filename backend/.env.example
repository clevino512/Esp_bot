# ── App ───────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=UniBot ESPA
APP_VERSION=1.0.0
DEBUG=true

# ── LLM ───────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b

# ── ChromaDB ───────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=espa_knowledge_base
CHROMA_DISTANCE_FUNCTION=cosine

# ── Embeddings ────────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
HUGGINGFACE_CACHE_DIR=/app/.cache/huggingface

# ── RAG ───────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
MIN_RELEVANCE_SCORE=0.65
FALLBACK_THRESHOLD=0.40

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=unibot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@postgres:5432/unibot

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=3600
CONVERSATION_HISTORY_MAX=20

# ── JWT Auth ─────────────────────────────────────────────────
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── ASR (Speech-to-Text) ─────────────────────────────────────
ASR_MODE=whisper
WHISPER_MODEL=base
WHISPER_LANGUAGE=fr
WHISPER_DEVICE=cpu
VOSK_MODEL_PATH=/app/.cache/vosk/vosk-model-fr-0.22
VOSK_SAMPLE_RATE=16000

# ── TTS (Text-to-Speech) ──────────────────────────────────────
TTS_ENGINE=gtts
TTS_LANGUAGE=fr

# ── Audio ────────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_MAX_DURATION_SECONDS=60
AUDIO_MAX_FILE_SIZE_MB=10

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=30

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/unibot.log

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@espa.mg
ADMIN_DEFAULT_PASSWORD=admin123
