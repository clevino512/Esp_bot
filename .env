# =============================================================
# UniBot ESPA — Variables d'Environnement
# Copier vers .env et renseigner les valeurs réelles
# NE JAMAIS committer le fichier .env dans Git
# =============================================================

# -------------------------------------------------------
# ENVIRONNEMENT
# -------------------------------------------------------
APP_ENV=development              # development | production
APP_NAME=Esp_Bot
APP_VERSION=1.0.0
DEBUG=true                       # false en production

# -------------------------------------------------------
# LLM — Modèle de Langage
# -------------------------------------------------------
# Choix du provider : openai (en ligne) | ollama (hors-ligne local)
LLM_PROVIDER=openai

# OpenAI (mode en ligne)
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini         # gpt-4o-mini (économique) | gpt-4o (précis)
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.2           # Faible pour réponses factuelles

# Ollama (mode hors-ligne — nécessite service ollama actif)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b          # mistral:7b | llama3:8b

# -------------------------------------------------------
# BASE VECTORIELLE — ChromaDB
# -------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=espa_knowledge_base
CHROMA_DISTANCE_FUNCTION=cosine

# -------------------------------------------------------
# EMBEDDINGS — Sentence Transformers
# -------------------------------------------------------
# Modèle multilingue (français inclus) — ~400 MB
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu             # cpu | cuda
HUGGINGFACE_CACHE_DIR=/app/.cache/huggingface

# -------------------------------------------------------
# RAG PIPELINE — Paramètres de Récupération
# -------------------------------------------------------
CHUNK_SIZE=500                   # Taille des chunks en tokens
CHUNK_OVERLAP=50                 # Overlap entre chunks consécutifs
TOP_K_RETRIEVAL=5                # Nombre de chunks récupérés
MIN_RELEVANCE_SCORE=0.65         # Score minimum pour retenir un chunk
FALLBACK_THRESHOLD=0.40          # Seuil en dessous duquel on déclare "hors domaine"

# -------------------------------------------------------
# POSTGRESQL — Base Relationnelle
# -------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=esp_bot
POSTGRES_USER=root
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://unibot_user:CHANGEZ_MOI@postgres:5432/unibot_db

# -------------------------------------------------------
# REDIS — Cache et Sessions
# -------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_REDIS
REDIS_URL=redis://:CHANGEZ_MOI@redis:6379/0
SESSION_TTL_SECONDS=3600         # Durée vie session (1h)
CONVERSATION_HISTORY_MAX=20      # Nb max messages gardés en mémoire

# -------------------------------------------------------
# SÉCURITÉ — JWT Authentification Admin
# -------------------------------------------------------
# Générer avec : openssl rand -hex 32
SECRET_KEY=CHANGEZ_MOI_GENEREZ_AVEC_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------
# ASR — Reconnaissance Vocale Automatique
# -------------------------------------------------------
# Mode ASR : whisper (en ligne, précis) | vosk (hors-ligne, léger)
ASR_MODE=whisper

# Whisper (OpenAI)
WHISPER_MODEL=base               # tiny | base | small | medium | large-v3
WHISPER_LANGUAGE=fr              # Forcer français (améliore précision)
WHISPER_DEVICE=cpu               # cpu | cuda

# Vosk (hors-ligne)
VOSK_MODEL_PATH=/app/.cache/vosk/vosk-model-fr-0.22
VOSK_SAMPLE_RATE=16000

# -------------------------------------------------------
# TTS — Synthèse Vocale
# -------------------------------------------------------
# Moteur TTS : gtts (en ligne) | coqui (hors-ligne)
TTS_ENGINE=gtts
TTS_LANGUAGE=fr

# Coqui TTS (hors-ligne)
COQUI_MODEL=tts_models/fr/css10/vits
COQUI_MODEL_PATH=/app/.cache/coqui

# -------------------------------------------------------
# AUDIO — Paramètres Signal
# -------------------------------------------------------
AUDIO_SAMPLE_RATE=16000          # Hz — standard Whisper/Vosk
AUDIO_MAX_DURATION_SECONDS=60   # Durée max enregistrement
AUDIO_MAX_FILE_SIZE_MB=10       # Taille max fichier audio upload

# -------------------------------------------------------
# CORS & SÉCURITÉ API
# -------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# En production : ALLOWED_ORIGINS=https://unibot.espa.mg
RATE_LIMIT_PER_MINUTE=30        # Requêtes max par IP par minute

# -------------------------------------------------------
# LOGGING
# -------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | text
LOG_FILE=/app/logs/unibot.log

# -------------------------------------------------------
# ADMIN
# -------------------------------------------------------
ADMIN_EMAIL=clevino512@gmail.com
ADMIN_DEFAULT_PASSWORD=clevino512
